# Optional temporary configuration: supply BOTH a service URL and a token.
# Leave empty to use the default named profile. Create one with
# `shifu-cli.py profile set <name> --base-url cn|com|https://your-service.example`.
# Explicit --profile <name> ignores both environment values for that invocation.
SHIFU_BASE_URL=

# Browser login writes independent credentials to profiles/<internal-id>/
# credentials.json below ${XDG_CONFIG_HOME:-~/.config}/ai-shifu (overridden by
# AI_SHIFU_CONFIG_DIR). Use `login --profile <name>` for browser authorization.
# A temporary token, for example in CI, is never copied into a profile.
SHIFU_TOKEN=

# Optional: set to 1 to omit all four CLI usage/Agent metadata headers.
# The CLI supplies its bundled release version and detected Agent display name;
# the backend validates them and generates the analytics User-Agent.
# This prevents the backend's new CLI pageview reporting. When reporting is
# enabled, records can be associated with the account; they are not anonymous.
# No environment values, model identifiers, or course content are collected as
# usage metadata. See references/cli/cli-reference.md#skill-usage-analytics.
SHIFU_DISABLE_ANALYTICS=
