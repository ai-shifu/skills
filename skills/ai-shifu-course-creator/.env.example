# Optional temporary configuration: supply BOTH a service URL and a token.
# Leave empty to use the default named profile. Create one with
# `shifu-cli.py profile set <name> --base-url cn|com|https://your-service.example`.
# Explicit --profile <name> ignores both environment values for that invocation.
SHIFU_BASE_URL=

# Browser login writes independent credentials to profiles/<internal-id>/
# credentials.json below ${XDG_CONFIG_HOME:-~/.config}/ai-shifu (overridden by
# AI_SHIFU_CONFIG_DIR). Use `login --profile <name>` for browser authorization.
# A temporary token, for example in CI, is never copied into a profile.
SHIFU_TOKEN=

# Distribution packages set this controlled channel value. Direct installs
# should leave it empty and are recorded as `direct`.
# Allowed: workbuddy, doubao, lobster, codex, direct.
AI_SHIFU_HOST_PLATFORM=
